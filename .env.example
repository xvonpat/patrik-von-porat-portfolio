# =========================================================================
# Next.js + Payload CMS + Supabase Integration Environment Variables
# =========================================================================

# Database Connection (Supabase PostgreSQL)
# -------------------------------------------------------------------------
# IMPORTANT: Use the "Transaction Pooler" connection string (Port 6543) 
# to prevent serverless Next.js functions from exhausting connection pools.
# Replace [YOUR-PASSWORD] with your actual Supabase database password.
DATABASE_URL="postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Payload CMS Secrets
# -------------------------------------------------------------------------
# You can generate a random secret key using: openssl rand -base64 32
PAYLOAD_SECRET="generate-a-secure-random-secret-key-and-put-it-here"

# Supabase Storage (S3-Compatible Uploads)
# -------------------------------------------------------------------------
# Locate these under Project Settings > Storage in your Supabase Dashboard.
SUPABASE_S3_ACCESS_KEY_ID="your-s3-access-key-id-from-supabase"
SUPABASE_S3_SECRET_ACCESS_KEY="your-s3-secret-access-key-from-supabase"
SUPABASE_S3_ENDPOINT="https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3"
SUPABASE_S3_BUCKET="payload-media"

# Google OAuth Admin Credentials
# -------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/oauth/google/callback"
OWNER_EMAIL="your-google-email@gmail.com"

# Workbench Assistant (Private AI)
# -------------------------------------------------------------------------
# Required to enable AI story generation & draft suggestions.
# Uses OpenAI Responses API with vision & text capabilities.
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o"

